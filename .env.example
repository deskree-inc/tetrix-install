# Tetrix local stack (Keycloak) — run ./scripts/setup.sh
# Only OPENAI_API_KEY is prompted. Unset/empty secrets below auto-generate on
# first setup and are written into .env so re-runs / restarts never rotate them
# (Helm twin: values override → lookup existing Secret → randAlphaNum).

# ── Public hostname (setup.sh maps to 127.0.0.1 in /etc/hosts) ────────────────
TETRIX_HOST=tetrix.local

# ── Where first-party images come from (ADR-0024 registry broker) ─────────────
# Prefix applied to the deskree/* images ONLY. Third-party images (pgvector,
# neo4j, meilisearch, minio, vault, busybox) always keep their own origins — the
# broker's allowlist is the Tetrix repos, so it would refuse them anyway.
#
# registry.deskree.com is Deskree's pull-through proxy. It authenticates with a
# credential minted from LICENSE_TOKEN below and valid for at most an hour;
# ./scripts/registry-login.sh mints one and runs `docker login` for you, and
# setup.sh calls it before starting the stack. That replaces the long-lived
# Docker Hub credential Support used to hand out.
#
# Set to empty to pull from Docker Hub instead (needs your own `docker login`,
# and an unlicensed install has to do this) — and clear TETRIX_BROKER_ENABLED
# below with it, the two describe the same decision:
#   TETRIX_IMAGE_ORIGIN=
#   TETRIX_BROKER_ENABLED=false
TETRIX_IMAGE_ORIGIN=registry.deskree.com/
# Moves WITH TETRIX_IMAGE_ORIGIN. registry-login.sh (and the optional timer) keep
# the HOST's `docker login` fresh for `docker compose pull`, but an in-app
# self-upgrade runs in a sibling container that does not share the host's docker
# config — this is what makes that sibling mint its own credential just in time
# (ADR-0024 P5). With the origin repointed and this off, self-upgrade pulls fail.
TETRIX_BROKER_ENABLED=true

# ── Image tags (optional overrides) ───────────────────────────────────────────
# Compose pins reproducible defaults in docker-compose.yml (${VAR:-tag}).
# Collectors defaults match Helm values.yaml collectors.image.tag (0.18.0).
# Leave unset (or delete these lines) to use those defaults; set only to override.
# Do not use :latest — pins keep local stacks reproducible.
TETRIX_IMAGE_TAG=sha-7dd9f22
GATEWAY_IMAGE_TAG=sha-b51cd15
KEYCLOAK_IMAGE_TAG=sha-7503768
FRONTEND_IMAGE_TAG=sha-a5e22da
AUDIT_LOGS_IMAGE_TAG=sha-74d6f6d
# Must be >= collectors#592 + #598 for the brokered Vault wiring this stack provisions —
# an older image ignores VAULT_TENANT_TOKEN_ROLE/VAULT_ONBOARDING_TOKEN and uses the broker
# token directly, which has `deny` on the whole KV mount. sha-4e65ada is the image the
# clean-room A/B for chart 0.8.13 ran against.
COLLECTORS_IMAGE_TAG=sha-e2abdd9
# Lockstep with updater (admin-api#95 / #91/#92). sha-6540df2 lacks /v1/update/*.
# sha-48d76f3 adds installation offboarding (ADR-0023 D3, admin-api#110) plus the rest of
# that arc every earlier pin predates (D2 #101, P1 #102, D6's people read #105) and per-invite
# delivery reporting (#106). It still carries the invite-delivery fix (admin-api#98) — required alongside
# TETRIX_INVITE_EMAIL=true below, or an SMTP failure 502s invite creation.
ADMIN_API_IMAGE_TAG=sha-195f930
LICENSING_IMAGE_TAG=sha-48d76f3
# Platform self-update service (ADR-0022). Behind the `updater` compose PROFILE —
# plain `docker compose up -d` does not start it. Enable with
# `docker compose --profile updater up -d` (or COMPOSE_PROFILES=updater below).
# sha-48d76f3: lockstep with admin-api/licensing (admin-api#110) — adds the ADR-0024 broker
# credential relay (#107) + the just-in-time compose credential (#108). Carries admin-api#99
# (honest credential_model), #96 pod-log Accept and
# #95 MicroTime / imagePullSecrets / helm Digest stderr.
UPDATER_IMAGE_TAG=sha-48d76f3
VAULT_IMAGE_TAG=1.21.4
# Third-party MinIO pins. These were `:latest` until Cloud M0.3 — a moving tag in
# a released bundle means two VMs installed from the same signed artifact can run
# different object-store code. Overrides only; the release lock
# (docker-compose.release.yml) is authoritative for an actual release.
MINIO_IMAGE_TAG=RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE_TAG=RELEASE.2025-08-13T08-35-41Z
# Multi-arch tags (amd64+arm64). Compose defaults to linux/arm64 (Apple Silicon / ARM).
# On Intel/amd64 hosts, set both to linux/amd64 (or leave unset only if you remove platform from compose).
FRONTEND_PLATFORM=linux/arm64
COLLECTORS_PLATFORM=linux/arm64

# ── Release identity (probe telemetry — vendor fleet view) ────────────────────
# Version of the applied release pin-set. setup.sh stamps this from a VERSION
# file at the compose root when the bundle came from a versioned release tarball
# (deploy-docker-<version>.tgz); leave empty for git checkouts / manual
# downloads (empty = unknown). Reported as TETRIX_LICENSING_APP_VERSION /
# TETRIX_LICENSING_CHART_VERSION.
TETRIX_RELEASE_VERSION=
# Where images are pulled from: origin (Docker Hub / upstream registries) or
# customer_mirror (a private registry mirror). Informational only.
TETRIX_REGISTRY_MODE=origin

# ── Platform self-update (in-app Owner upgrade — ADR-0022) ────────────────────
# OPT-IN. The `updater` service is in the `updater` compose profile (twin of Helm's
# adminApi.updater.enabled=false), so it is not started by `docker compose up -d`.
# Enable it for every compose command in this project by uncommenting:
# COMPOSE_PROFILES=updater
# ...or per command: `docker compose --profile updater up -d`. Read the docker.sock
# trust note in docker-compose.yml first — this container is trusted with the host.
#
# ── Credential health check (collectors ADR-0050 §5; collectors#603) ──────────
# OPT-IN, twin of Helm's collectors.healthcheck.enabled=false. `collectors-healthcheck` sits in
# PRECONDITION: COLLECTORS_IMAGE_TAG (above) must be at or after be07342 (collectors#601, the
# crash-on-boot fix for this profile — older images CrashLoop with no log line), and recreate
# vault-init once after pulling this version so runtime/vault-read.env exists.
# the `healthcheck` compose profile: it re-probes each connection's credential when its
# next_check_at is due and flips it to the sticky `needs_reauth` after N consecutive rejections,
# so an expired PAT is noticed BEFORE the next sync fails. Enable it with
# `docker compose --profile healthcheck up -d`, or for every command in this project by setting
# COMPOSE_PROFILES to a comma list, e.g.
# COMPOSE_PROFILES=healthcheck        # or: COMPOSE_PROFILES=updater,healthcheck
# Knobs (defaults match the collectors image): how often the loop wakes, the per-connection
# re-check cadence stamped on next_check_at, and the rejections-before-needs_reauth count.
# HEALTHCHECK_TICK_SECONDS=300
# HEALTHCHECK_INTERVAL_SECONDS=3600
# HEALTHCHECK_MAX_AUTH_FAILURES=3
#
# ── HITL answer write-back (collectors ADR-0068 §3; collectors#610) ───────────
# OPT-IN, twin of Helm's collectors.hitl.enabled=false. `collectors-hitl` sits in the `hitl`
# compose profile: it drains hitl_question.events and folds each human answer into the graph at
# origin="human". WITHOUT IT, answering a HITL question changes nothing — the answer is recorded,
# the event is staged, and the graph never sees it. Nothing errors; the queue just grows.
# Enable with `docker compose --profile hitl up -d`, or for every command in this project via
# COMPOSE_PROFILES, e.g.
# COMPOSE_PROFILES=hitl               # or: COMPOSE_PROFILES=healthcheck,hitl
# Answers queued while it is off are replayed when it is switched on (the write-back is a
# deterministic natural-key upsert). Knobs (defaults match the collectors image): messages per
# drain pass, and the sleep between passes when the queue is empty.
# HITL_BATCH=10
# HITL_POLL_SECONDS=5
#
# ── Identity projector (collectors ADR-0052; collectors#611) ──────────────────
# OPT-IN, twin of Helm's collectors.identityConsumer.enabled=false.
# `collectors-identity-consumer` sits in the `identity-consumer` compose profile: it drains
# identity_link.events and turns admin identity mappings into a person node with human-asserted
# same_as edges. WITHOUT IT, saving a mapping through /identities changes nothing in the graph —
# the same human stays several unrelated identities, and ownership answers stay fragmented.
# Nothing errors; the queue grows. Enable with `docker compose --profile identity-consumer up -d`,
# or for every command in this project via COMPOSE_PROFILES, e.g.
# COMPOSE_PROFILES=identity-consumer   # or: COMPOSE_PROFILES=hitl,identity-consumer
# Events queued while it is off are replayed when it is switched on. Knobs (defaults match the
# collectors image): messages per drain pass, and the sleep between passes when the queue is empty.
# IDENTITY_CONSUMER_BATCH=10
# IDENTITY_CONSUMER_POLL_SECONDS=5
#
# ── Session projector (collectors ADR-0045; chart#254) ────────────────────────
# DEFAULT ON, twin of Helm's collectors.sessionConsumer.enabled=true.
# `collectors-session-consumer` starts with `docker compose up -d` (no profile).
# It drains coding_session.events and projects each saved agent session into the
# graph as an agent_session node. WITHOUT IT, save_session stores every checkpoint
# in the control plane and session_context / repo_sessions answer "not found".
# Knobs (defaults match the collectors image):
# SESSION_CONSUMER_BATCH=10
# SESSION_CONSUMER_POLL_SECONDS=5
#
# Absolute HOST path of this compose project. setup.sh stamps it. The project is
# mounted INSIDE the updater at the fixed path /compose (never at the host path —
# that would shadow the image's own directories); this value is used only to build
# the transient apply sibling's `docker run -v $HOST:$HOST`, which must name a host
# path. Leave empty for a manual `docker compose up`: in-place reads/writes still
# work, only the sibling apply needs it.
COMPOSE_PROJECT_DIR=
# admin-api → updater HTTP timeout, and the minimum gap between accepted
# upgrades (Helm twin: adminApi.updater.timeoutSeconds / cooldownSeconds).
UPDATER_TIMEOUT_S=10
UPDATER_COOLDOWN_S=900
# ── Updater ops hook (Tetrix Cloud only — leave EMPTY on-prem) ────────────────
# These four are what let the updater take a full pre-upgrade application archive,
# run the composite health gate, and roll data back if the upgrade fails. They
# close ADR-0022's known gap: compose rollback restores files and pins but NOT
# database migrations, so a failed upgrade used to leave a new schema under old
# code.
#
# EMPTY IS THE ON-PREM CONTRACT, not an omission. An unset ops script is how the
# updater knows there is no backup hook to call, and an on-prem install has no
# /var/lib/tetrix, no health-gate.sh prerequisites and no backup bucket. Cloud
# sets all four from scripts/compose.sh, which is the only cloud entrypoint.
TETRIX_UPDATER_COMPOSE_OPS_SCRIPT=
TETRIX_UPDATER_COMPOSE_OPS_TIMEOUT_S=
TETRIX_UPDATER_COMPOSE_BACKUP_DIR=
TETRIX_UPDATER_COMPOSE_MUTABLE_ENV=
# Sibling bind sources for the hook. Cloud resolves /var/lib/tetrix/backups and
# /run/tetrix; the in-project defaults keep a dev checkout's binds inside the
# project.
TETRIX_BACKUP_DIR=
TETRIX_UPDATER_RUNTIME_BIND=
# Updater posts here for the signed manifest (licensing's brokered relay — never
# ops directly). Helm twin: templates/updater-deployment.yaml.
# UPDATER_RELEASES_CHECK_URL=http://licensing:8000/v1/update/release
# Documented baked path of the release-manifest verify keyset (current images
# ignore this env — trust root is not runtime-settable).
# UPDATER_MANIFEST_KEYS_PATH=/app/updater/baked_keys/public_keys.json

# ── IAM bootstrap (daemon SDK / collectors) ───────────────────────────────────
AIDB_USERNAME=developer
AIDB_ORG=default

# ── Secrets — leave empty to auto-generate (setup.sh persists into .env) ───────
# Chart-managed set (same names as Helm secrets.* / <release>-tetrixaidb-secrets):
#   TETRIX_PASSWORD, AIDB_PASSWORD, POSTGRES_PASSWORD,
#   NEO4J_PASSWORD, MEILI_MASTER_KEY, MINIO_ROOT_PASSWORD,
#   KEYCLOAK_DB_PASSWORD, KEYCLOAK_ADMIN_PASSWORD, CONTROL_PLANE_DB_PASSWORD
# Pin any value explicitly to override auto-gen. Re-running setup.sh reuses .env.
TETRIX_PASSWORD=
AIDB_PASSWORD=
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
MEILI_MASTER_KEY=
MINIO_ROOT_USER=tetrix
MINIO_ROOT_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
CONTROL_PLANE_DB_PASSWORD=
# Keycloak owner / admin-client / password-verify (Helm dedicated Secrets; auto-gen when empty):
# Local development only. Tetrix Cloud leaves this EMPTY on purpose: there is no
# Owner bootstrap credential anywhere on a tenant VM, and the Owner sets their own
# password through the one-time Keycloak action email instead (see
# KEYCLOAK_SMTP_* below). Setting it here in cloud mode would put an Owner
# credential into Vault, into every backup, and into updater state.
KEYCLOAK_OWNER_PASSWORD=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_PASSWORD_VERIFY_CLIENT_SECRET=
# Empty ⇒ fall back to TETRIX_PASSWORD after it is resolved (Helm twin).
ADMIN_API_IAM_PASSWORD=
LICENSING_IAM_PASSWORD=

# ── Required — setup.sh prompts if empty ──────────────────────────────────────
OPENAI_API_KEY=

# ── Explore agent (collectors-api chat dock) ──────────────────────────────────
# EMPTY IS A VALID INSTALL — the agent is disabled and the dock shows a
# degraded face. setup.sh does NOT prompt. Same treatment as Helm
# secrets.exploreLlmApiKey: no required. Optional after first install.
EXPLORE_LLM_API_KEY=
# Knobs (defaults match Helm explore: / the collectors image). 0 DISABLES the
# hourly ceiling — deliberate. A typo or a negative falls back to 60 in
# collectors rather than silently removing the guard.
# EXPLORE_LLM_PROVIDER=anthropic
# EXPLORE_LLM_MODEL=claude-haiku-4-5-20251001
# EXPLORE_RATE_LIMIT_PER_HOUR=60

# ── Deployment mode (dev here; a Tetrix Cloud VM sets cloud) ──────────────────
# dev   this file is the persisted secret store, as it always has been.
# cloud nothing is persisted: /etc/tetrix/cloud.env holds the non-secret config
#       and /run/tetrix/runtime.env is rendered from Vault on every boot. Never
#       set cloud here — the installer owns it.
TETRIX_DEPLOYMENT_MODE=dev
# Immutable lifecycle UUID and the slug the public host derives from. Empty
# outside Tetrix Cloud; they are NOT hostnames and not interchangeable.
TETRIX_DEPLOYMENT_ID=
TETRIX_DEPLOYMENT_SLUG=
# self_signed (default, local) | acme (cloud only, *.tetrix.deskree.com only).
# scripts/render-traefik-tls.sh refuses acme anywhere else, so a stale value here
# fails loudly rather than ordering a certificate that can never validate.
TETRIX_TLS_MODE=self_signed
TETRIX_ACME_EMAIL=platform@deskree.com
TETRIX_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# Where the rendered edge config and the ACME account live. Cloud derives
# /run/tetrix/runtime/traefik and /var/lib/tetrix/acme; leave both empty locally
# to render in place under traefik/ and runtime/acme/.
TETRIX_TRAEFIK_DIR=
TETRIX_ACME_DIR=
# Bind address for the non-Traefik published ports. Cloud sets 127.0.0.1 so only
# Traefik is reachable from outside the VM.
TETRIX_BIND_ADDRESS=0.0.0.0

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_OWNER_EMAIL=owner@tetrix.local
# OPTIONAL operator pin (#235). LEAVE IT BLANK unless you know the UUID a priori: the
# keycloak-owner-org-resolve one-shot reads the daemon's organizations table on every run and
# resolves the row named AIDB_ORG, so nothing goes stale across a `docker compose down -v`.
# When it IS set it must be a daemon organizations.id UUID (not the AIDB_ORG name) and it is
# VALIDATED against that table — an id no organizations row carries FAILS the install rather
# than creating a Keycloak group for an organization that does not exist. If a reinstall stops
# with that error, clear this value (or set it to the id the error message prints).
KEYCLOAK_OWNER_ORG_ID=
KEYCLOAK_CLIENT_ID=tetrix-frontend
KEYCLOAK_ADMIN_API_CLIENT_ID=tetrix-admin-api
KEYCLOAK_PASSWORD_VERIFY_CLIENT_ID=tetrix-account-verify
KEYCLOAK_SCOPES=openid email profile
# Space-separated anonymous DCR trusted hosts (Helm default set + local host).
KEYCLOAK_TRUSTED_HOSTS="localhost 127.0.0.1 anysphere.cursor-mcp www.cursor.com claude.ai chatgpt.com tetrix.local"
# Includes offline_access for Claude Code DCR; repair loop fixes KC #50807 MCP default drop.
# Also carries the MCP write scopes (sessions:write, hitl:write) — an EXISTING .env keeps its
# old value, so re-add them by hand on a VM/host provisioned before chart 0.7.129 (#189).
KEYCLOAK_ALLOWED_DCR_SCOPES=res:mcp graph:read sessions:write hitl:write basic profile email offline_access

# ── Owner onboarding mail (Resend as the realm's SMTP server) ─────────────────
# Wired (Wave B, on #235's adopt-or-fail contract): keycloak-provision writes
# these into the realm's smtpServer and mirrors the
# password into the realm attribute tetrix.smtpPassword — which is where
# admin-api's existing SmtpInviteEmailer reads it. One Resend account serves both
# the Keycloak-sent Owner action email and app-sent member invites; there is no
# second mailer and nothing calls the Resend HTTP API.
#
# KEYCLOAK_SMTP_PASSWORD is the Resend API key. In cloud mode it is rendered from
# Vault (RESEND_API_KEY) into the tmpfs env and never written to disk. Leave it
# empty locally: an empty value simply skips the realm SMTP merge, and local
# development keeps its password-based Owner.
KEYCLOAK_SMTP_HOST=smtp.resend.com
KEYCLOAK_SMTP_PORT=465
KEYCLOAK_SMTP_USERNAME=resend
KEYCLOAK_SMTP_FROM_EMAIL=notifications@tetrix.deskree.com
KEYCLOAK_SMTP_FROM_NAME=Tetrix Cloud
KEYCLOAK_SMTP_SSL=true
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_PASSWORD=
# One-time Owner action email lifespan, in seconds. 86400 is the locked cloud
# value; the link is single-use and expires with it.
KEYCLOAK_OWNER_INVITE_LIFESPAN_SECONDS=86400

# ── Derived URLs (synced by setup.sh from TETRIX_HOST) ────────────────────────
TETRIX_PUBLIC_URL=https://tetrix.local
KEYCLOAK_HOSTNAME=https://tetrix.local/auth
KEYCLOAK_ISSUER=https://tetrix.local/auth/realms/tetrix
KEYCLOAK_AUDIENCE_DAEMON=https://tetrix.local/api
MCP_BASE_URL=https://tetrix.local/mcp
COLLECTORS_AUDIENCE_API=https://tetrix.local/api-collectors
COLLECTORS_AUDIENCE_MCP=https://tetrix.local/mcp

# ── Licensing (real Deskree token required for local testing) ─────────────────
# Paste a Deskree-issued license token in the SPA admin UI after setup, or set
# LICENSE_TOKEN here and recreate the licensing service. Empty means unlicensed
# until you paste one — that is not the happy path for this full stack.
LICENSE_TOKEN=
# UNUSED: deskree/tetrix-licensing loads verify keys ONLY from
# /app/licensing/baked_keys/public_keys.json (compose mounts .local-license-keys/).
# setup.sh fetches https://ops.deskree.com/api/licensing/keys → .keys into that
# dir (Helm baked-keys twin; kid k1). Do not rely on the image default "dev" kid
# or on this env var.
LICENSE_PUBLIC_KEYS=

# ── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_ENABLED=true
GATEWAY_CACHE_TTL=30s
# LICENSING_CHECK_TTL=60s

# ── Collectors ────────────────────────────────────────────────────────────────
COLLECTORS_TETRIX_USERNAME=developer
# Legacy single-tenant slug (Writer stamp / MCP seed). With ADR-0012 multi-tenant
# Collectors API (COLLECTORS_AUTH_ORG_IDENTITY=true, default), human SPA traffic
# uses daemon org UUIDs as aidb_account — not this slug.
COLLECTORS_SERVING_ACCOUNT=tetrix-demo
# ADR-0012 / ADR-0016: Collectors API + MCP multi-tenant (aidb_account = org UUID).
# Sets TETRIX_API_AUTH_ORG_IDENTITY and TETRIX_MCP_AUTH_ORG_IDENTITY. Default true
# for this Keycloak stack. Set false only for hermetic single-tenant overlays.
# MCP ?org= org-select requires a collectors image with ADR-0016 before prod rollout.
# Flipping true over an existing slug-owned graph requires a **clean install**
# (docker compose down -v / wipe control_plane + org graph data) — no migration.
COLLECTORS_AUTH_ORG_IDENTITY=true

# ── Code intelligence + graph hydration ───────────────────────────────────────
# These four MUST track templates/collectors-configmap.yaml. ADR-0019 calls this
# deploy/docker tree the chart's Compose TWIN, and until now it set none of them —
# so the collectors ran here with code-symbol extraction OFF while every K8s install
# ran it ON. Consequences of that drift, both measured on 2026-08-16:
#   · a clean-room sync produced `index_code -> {"modes":{"off":8},"symbols":0}` where
#     the same repos in GKE produce `{"modes":{"native":10},"symbols":16240}`;
#   · the resulting graph carried NONE of the in_unit/defined_in code edges, which are
#     ~68% of the production graph's edges (23,088 + 13,980 of 54,373).
# Every clean-room A/B touching GitHub was therefore comparing a materially lighter
# product than the one that ships. Defaults below mirror the chart's values.yaml
# (collectors.worker.codeSymbols / .selfAttribute / .emitCouplingMeta and
# collectors.api.graphIncludeRelations).
CODE_SYMBOLS=native
CODE_NATIVE_SELF_ATTRIBUTE=1
CODE_NATIVE_EMIT_COUPLING_META=1
GRAPH_INCLUDE_RELATIONS=1

# ── admin-api IAM (defaults filled by setup.sh) ───────────────────────────────
ADMIN_API_IAM_ENDPOINT=tcp://daemon:7779
ADMIN_API_IAM_USERNAME=superadmin
TETRIX_INVITE_EMAIL=true

# ── Audit logs (tetrix-audit-logs — ADR-0013 read + helm#48 emit) ─────────────
AUDIT_RETENTION_DAYS=365
AUDIT_INGEST_TOKENS=tetrix-admin-api:dev-admin-ingest,tetrix-collectors:dev-collectors-ingest
AUDIT_QUERY_TOKENS=dev-admin:dev-query-token
# Emitter overrides (compose defaults already point at audit-logs:8090)
# ADMIN_API_AUDIT_URL=http://audit-logs:8090
# ADMIN_API_AUDIT_TOKEN=dev-admin-ingest
# COLLECTORS_AUDIT_URL=http://audit-logs:8090
# COLLECTORS_AUDIT_TOKEN=dev-collectors-ingest
